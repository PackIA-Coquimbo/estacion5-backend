# Copiar a .env y ajustar si hace falta (el .env no se sube al repo).
# Sin .env, docker compose usa estos mismos valores por defecto.

# Puerto del computador donde queda la API (dentro del contenedor siempre es 8000)
API_PORT=8000

# Base de datos. Por defecto SQLite dentro del volumen e5_datos.
DATABASE_URL=sqlite:////app/data/e5.db
# Opción PostgreSQL (requiere agregar un servicio de base de datos):
# DATABASE_URL=postgresql+psycopg://usuario:clave@db:5432/e5

# Zona horaria del contenedor (los timestamps de las estaciones vienen con zona)
TZ=America/Santiago
